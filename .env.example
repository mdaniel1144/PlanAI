# Export these variables in your shell/service environment; no automatic dotenv loader.
DATABASE_PATH=data/habitat.sqlite
SESSION_TTL_DAYS=7
# Production requires NODE_ENV=production and the canonical HTTPS browser origin:
# APP_ORIGIN=https://habitat.example.com
# ADMIN_EMAIL, ADMIN_NAME and ADMIN_PASSWORD are only for pnpm auth:bootstrap.
# Do not store a real administrator password here.

# Catalog assets (relative paths resolve from the workspace root):
STORAGE_PATH=storage
ITEM_GLB_MAX_BYTES=52428800
ITEM_IMAGE_MAX_BYTES=12582912
ITEM_IMAGE_MAX_RESOLUTION=4096
ITEM_MAX_NODES=5000
ITEM_MAX_MESHES=2000
ITEM_MAX_MATERIALS=512
